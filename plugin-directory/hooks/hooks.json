{
  "description": "Phaedo: check with you before Claude merges, deploys or publishes.",
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash|mcp__.*(send|reply|forward|post|publish|comment|share|invite|pay|purchase|transfer|checkout|buy|delete|purge|destroy|trash|merge).*", "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/pre-ship.mjs"], "timeout": 15 }] }
    ],
    "PermissionRequest": [
      { "matcher": "Bash|mcp__.*(send|reply|forward|post|publish|comment|share|invite|pay|purchase|transfer|checkout|buy|delete|purge|destroy|trash|merge).*", "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/pre-ship.mjs"], "timeout": 15 }] }
    ],
    "PostToolUse": [
      { "matcher": "Bash|mcp__.*(send|reply|forward|post|publish|comment|share|invite|pay|purchase|transfer|checkout|buy|delete|purge|destroy|trash|merge).*", "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/pre-ship.mjs"], "timeout": 15 }] }
    ],
    "PostToolUseFailure": [
      { "matcher": "Bash|mcp__.*(send|reply|forward|post|publish|comment|share|invite|pay|purchase|transfer|checkout|buy|delete|purge|destroy|trash|merge).*", "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/pre-ship.mjs"], "timeout": 15 }] }
    ]
  }
}
