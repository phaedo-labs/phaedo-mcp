{
  "category": "TC-CANON",
  "describes": "Phaedo Protocol §6 canonical serialization, as implemented by Phaedo.Envelope.canonicalStringify (the v0.1 metadata-AAD canonicalizer).",
  "note": "v0.1 SUBSET of RFC 8785: object-key ordering (UTF-16 code units), recursive application, array-order preservation, UTF-8, and no insignificant whitespace all match RFC 8785. NOT yet covered: RFC 8785 number canonicalization for exponent/edge-case magnitudes (current impl defers number formatting to JSON.stringify) and minimal control-char escaping. These land with §8.3 signing. Inputs here use only the value types v0.1 artifacts/metadata contain, where the subset is byte-equal to RFC 8785.",
  "vectors": [
    {
      "test_id": "T-PHAEDO-CANON-0001",
      "description": "Object keys sorted by UTF-16 code unit (RFC 8785 §3.2.3), no whitespace",
      "input": {
        "b": 1,
        "a": 2,
        "c": 3
      },
      "expected_canonical": "{\"a\":2,\"b\":1,\"c\":3}",
      "expected_sha256": "e145110e712e3ed0a6b233551b27a90aa39b4c93ed67e111ba2002d16e5ed1fa"
    },
    {
      "test_id": "T-PHAEDO-CANON-0002",
      "description": "Nested object key sorting is recursive",
      "input": {
        "z": {
          "y": 1,
          "x": 2
        },
        "a": [
          3,
          2,
          1
        ]
      },
      "expected_canonical": "{\"a\":[3,2,1],\"z\":{\"x\":2,\"y\":1}}",
      "expected_sha256": "00284ff64ddee4ecd1b3c76fde9524200571a90c53d8c79e5e36e08d8d1d7d1c"
    },
    {
      "test_id": "T-PHAEDO-CANON-0003",
      "description": "Array element order is preserved (not sorted)",
      "input": [
        3,
        1,
        2,
        "b",
        "a"
      ],
      "expected_canonical": "[3,1,2,\"b\",\"a\"]",
      "expected_sha256": "50300122e6fdfef79ecb31e0447247453c80bc9fd0c146af68c052638f73572c"
    },
    {
      "test_id": "T-PHAEDO-CANON-0004",
      "description": "Scalars: string, integer, decimal, boolean, null",
      "input": {
        "s": "hi",
        "i": 42,
        "d": 0.5,
        "t": true,
        "f": false,
        "n": null
      },
      "expected_canonical": "{\"d\":0.5,\"f\":false,\"i\":42,\"n\":null,\"s\":\"hi\",\"t\":true}",
      "expected_sha256": "08df933f1830b61692840b9e064b34c4c9b25d1d5cc93dbaef8c2744bcfbf3dd"
    },
    {
      "test_id": "T-PHAEDO-CANON-0005",
      "description": "Unicode string preserved as UTF-8 (no ASCII-escaping)",
      "input": {
        "msg": "café — déjà",
        "emoji": "🜂"
      },
      "expected_canonical": "{\"emoji\":\"🜂\",\"msg\":\"café — déjà\"}",
      "expected_sha256": "37ea88c9e4ff389aa1c2edc5cde48436aa0cd750b23b9b8cad2520c2f5a8bf03"
    },
    {
      "test_id": "T-PHAEDO-CANON-0006",
      "description": "Empty object and empty array",
      "input": {
        "o": {},
        "a": []
      },
      "expected_canonical": "{\"a\":[],\"o\":{}}",
      "expected_sha256": "9bee7ebfc94b459dacb8cbc72cb2900e61f0aa42189df18329f84f92568f4f89"
    },
    {
      "test_id": "T-PHAEDO-CANON-0007",
      "description": "Realistic envelope metadata (the v0.1 AAD path)",
      "input": {
        "artifact_kind": "fingerprint",
        "fingerprint_id": "f1b9c4e2-7d3a-4e8b-9c0f-2a1b3c4d5e6f",
        "created_at": "2026-04-28T17:00:00Z"
      },
      "expected_canonical": "{\"artifact_kind\":\"fingerprint\",\"created_at\":\"2026-04-28T17:00:00Z\",\"fingerprint_id\":\"f1b9c4e2-7d3a-4e8b-9c0f-2a1b3c4d5e6f\"}",
      "expected_sha256": "33506f29240eb3a2b675bc9556a76e14774597349743acf1558f3fc437b2fd0f"
    },
    {
      "test_id": "T-PHAEDO-CANON-0008",
      "description": "RFC 8785 ES number formatting: integers, small/large magnitudes, trailing-zero drop",
      "input": {
        "a": 56,
        "b": 0.000001,
        "c": 1e-7,
        "d": 1e+21,
        "e": 10,
        "f": 0.1
      },
      "expected_canonical": "{\"a\":56,\"b\":0.000001,\"c\":1e-7,\"d\":1e+21,\"e\":10,\"f\":0.1}",
      "expected_sha256": "8d60231f13ba901aa110ea0d2be35adf188b3251a3f4a63f48d75c5b65dc7d6f"
    },
    {
      "test_id": "T-PHAEDO-CANON-0009",
      "description": "RFC 8785 ES number formatting: shortest round-trip precision at the double edge",
      "input": {
        "a": 1.0000000000000002,
        "b": 333333333.3333333,
        "c": 9007199254740994
      },
      "expected_canonical": "{\"a\":1.0000000000000002,\"b\":333333333.3333333,\"c\":9007199254740994}",
      "expected_sha256": "3c65d8e641cff4a556586a97cf118720f0b94b1650bae5abdd733263801796e3"
    },
    {
      "test_id": "T-PHAEDO-CANON-0010",
      "description": "Negative zero canonicalizes to 0 (RFC 8785 / ES Number::toString)",
      "input": {
        "z": 0
      },
      "expected_canonical": "{\"z\":0}",
      "expected_sha256": "e313adcae40818c4a48a6f5a32c7ab937365ffb0962282a5bf1a629f8d456b63"
    },
    {
      "test_id": "T-PHAEDO-CANON-0011",
      "description": "Minimal string escaping: short escapes, \\u00XX only for other control chars, no over-escaping of unicode",
      "input": {
        "nl": "a\nb",
        "tab": "a\tb",
        "ctl": "a\u0001b",
        "eur": "€",
        "quote": "a\"b",
        "backslash": "a\\b"
      },
      "expected_canonical": "{\"backslash\":\"a\\\\b\",\"ctl\":\"a\\u0001b\",\"eur\":\"€\",\"nl\":\"a\\nb\",\"quote\":\"a\\\"b\",\"tab\":\"a\\tb\"}",
      "expected_sha256": "57ced509e204edf5ffa04f25ab937105cfce0d2441d15cabfa9f938ac9e79909"
    },
    {
      "test_id": "T-PHAEDO-CANON-0012",
      "description": "Key sort is by UTF-16 code units of the RAW key: controls < digits < €",
      "input": {
        "1": 1,
        "2": 3,
        "10": 2,
        "€": 4,
        "\r": 0
      },
      "expected_canonical": "{\"\\r\":0,\"1\":1,\"10\":2,\"2\":3,\"€\":4}",
      "expected_sha256": "d2c2e075e58e4ec7f64fcafb502d91309719a95a08ec4fd7761ccd614dc474a6"
    },
    {
      "test_id": "T-PHAEDO-CANON-0013",
      "description": "Non-finite numbers are not expressible in RFC 8785 JSON — canonicalization MUST reject (never emit \"null\"). Runner substitutes Infinity for the marker.",
      "input": {
        "bad": "__INFINITY__"
      },
      "expect_error": true
    },
    {
      "test_id": "T-PHAEDO-CANON-0014",
      "description": "NaN likewise MUST be rejected. Runner substitutes NaN for the marker.",
      "input": {
        "bad": "__NAN__"
      },
      "expect_error": true
    },
    {
      "test_id": "T-PHAEDO-CANON-0015",
      "description": "§6.2: a decomposed (NFD) string VALUE is normalized to NFC before serialization — the two forms MUST canonicalize identically, or a signature breaks the moment either side re-normalizes (Apple platforms produce NFD routinely)",
      "input": {
        "text": "éclair"
      },
      "expected_canonical": "{\"text\":\"éclair\"}",
      "expected_sha256": "e2b22bba6cd1bdc4c19ec67b6bcc2b59abf518aae30f99f615c95a92fde8cb60"
    },
    {
      "test_id": "T-PHAEDO-CANON-0016",
      "description": "§6.2: the SAME string already in NFC produces byte-identical output to the NFD vector above — this pair is the whole point of the requirement",
      "input": {
        "text": "éclair"
      },
      "expected_canonical": "{\"text\":\"éclair\"}",
      "expected_sha256": "e2b22bba6cd1bdc4c19ec67b6bcc2b59abf518aae30f99f615c95a92fde8cb60"
    },
    {
      "test_id": "T-PHAEDO-CANON-0017",
      "description": "§6.2: object KEYS are normalized too, and sorting happens on the normalized key — normalizing only values would still yield two different canonical forms for the same document",
      "input": {
        "ñ": 1,
        "a": 2
      },
      "expected_canonical": "{\"a\":2,\"ñ\":1}",
      "expected_sha256": "fca2f1e86461ab9fa4600394f239c15139e615f208d6e7ba1a0f848bc381afbb"
    },
    {
      "test_id": "T-PHAEDO-CANON-0018",
      "description": "§6.2: normalization applies at every depth, inside arrays and nested objects alike",
      "input": {
        "outer": [
          {
            "k": "é"
          },
          {
            "k": "é"
          }
        ]
      },
      "expected_canonical": "{\"outer\":[{\"k\":\"é\"},{\"k\":\"é\"}]}",
      "expected_sha256": "7ec58944140dc7f46e4edb91b4c76d7cbdef9df2341bcb690e9047c1129a9a4f"
    }
  ]
}
