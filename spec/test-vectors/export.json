          "subject_id": "vector-subj-0001",
          "schema_revision": 4,
          "layers": {}
        },
        "pairing_token": "VECTOR-TOKEN-123456",
        "digest": "0lkJJGleAEI2n2o-OZe8pDEpdjo62dvoVeS5PQgXkBQ"
      }
