          "phaedo_protocol_version": "0.1",
          "fingerprint_id": "vector-fp-0001",
          "subject_id": "vector-subj-0001",
          "schema_revision": 4,
          "layers": {}
        },
        "pairing_token": "VECTOR-TOKEN-123456"
      },
      "expected": {
        "phaedo_export_version": "0.1",
        "mode": "bootstrap",
